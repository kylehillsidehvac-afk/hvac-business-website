
---
const businessName = "Hillside HVAC & Home Repair";
const description =
  "Residential HVAC and home repair services throughout Dutchess County, NY. Contact Hillside HVAC & Home Repair for your home comfort needs.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hillside HVAC & Home Repair | Dutchess County, NY</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1f305c" />
  </head>

  <body>
    <header>
      <a class="logo" href="/" aria-label="Hillside HVAC & Home Repair home">
        <img
          src="/images/hillside-logo.jpg"
          alt="Hillside HVAC & Home Repair"
        />
      </a>

      <nav aria-label="Main navigation">
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#service-area">Service Areas</a>
        <a href="#contact" class="nav-button">Contact Us</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <img
          class="hero-photo"
          src="/images/kyle-h-hvac.jpg"
          alt="Kyle of Hillside HVAC & Home Repair standing beside a residential water heater"
          fetchpriority="high"
        />

        <div class="hero-content">
          <p class="eyebrow">PROUDLY SERVING DUTCHESS COUNTY, NY</p>

          <h1>Comfort You Can Count On. Service You Can Trust.</h1>

          <p class="hero-description">
            Your home deserves dependable heating, cooling, and
            home repair services. Let Hillside help keep your
            home comfortable.
          </p>

          <a href="#contact" class="button">REQUEST SERVICE</a>
          <a href="#services" class="secondary-link">
            Explore Our Services →
          </a>
        </div>
      </section>

      <section class="intro fade-section">
        <p class="eyebrow">WELCOME TO HILLSIDE</p>
        <h2>Your Local Home Comfort & Repair Resource</h2>
        <p>
          Your home deserves attention and care. Hillside HVAC &
          Home Repair is focused on helping homeowners with their
          heating, cooling, and home repair needs throughout
          Dutchess County, New York.
        </p>
      </section>

      <section class="services" id="services">
        <div class="fade-section">
          <p class="eyebrow">WHAT WE DO</p>
          <h2>Our Services</h2>
          <p class="section-description">
            Home comfort and repair solutions to help keep your
            home running smoothly.
          </p>
        </div>

        <div class="service-grid">
          <article class="service-card fade-section">
            <div class="service-icon">01</div>
            <h3>Heating Services</h3>
            <p>
              Heating solutions to help keep your home warm
              and comfortable through the colder months.
            </p>
          </article>

          <article class="service-card fade-section">
            <div class="service-icon">02</div>
            <h3>Air Conditioning</h3>
            <p>
              Home cooling services to help you stay comfortable
              when temperatures rise.
            </p>
          </article>

          <article class="service-card fade-section">
            <div class="service-icon">03</div>
            <h3>Heat Pumps</h3>
            <p>
              Home heat pump solutions for year-round
              heating and cooling comfort.
            </p>
          </article>

          <article class="service-card fade-section">
            <div class="service-icon">04</div>
            <h3>Home Repair</h3>
            <p>
              Residential home repair services to help maintain
              and care for your home.
            </p>
          </article>
        </div>
      </section>

      <section class="local" id="service-area">
        <div class="fade-section">
          <p class="eyebrow">YOUR LOCAL SERVICE AREA</p>
          <h2>Serving Dutchess County, NY</h2>
          <p>
            Hillside HVAC & Home Repair is focused on helping
            homeowners throughout Dutchess County with their
            heating, cooling, and home repair needs.
          </p>
        </div>
      </section>

      <section class="about fade-section" id="about">
        <p class="eyebrow">ABOUT HILLSIDE</p>
        <h2>Taking Care of Your Home Starts Here</h2>
        <p>
          Your home is one of your biggest investments.
          Hillside HVAC & Home Repair is committed to being
          a dependable resource for your residential HVAC
          and home repair needs.
        </p>
      </section>

      <section class="contact fade-section" id="contact">
        <p class="eyebrow">LET'S GET STARTED</p>
        <h2>How Can We Help With Your Home?</h2>
        <p>
          Have a heating, cooling, or home repair project?
          Get in touch with Hillside HVAC & Home Repair.
        </p>
        <p class="contact-note">
          Contact information and service request options
          coming soon.
        </p>
      </section>
    </main>

    <footer>
      <img
        src="/images/hillside-logo.jpg"
        alt="Hillside HVAC & Home Repair"
      />
      <p>Serving Dutchess County, New York.</p>
      <p>© {new Date().getFullYear()} {businessName}. All rights reserved.</p>
    </footer>

    <script>
      const sections = document.querySelectorAll(".fade-section");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );

        sections.forEach((section) => observer.observe(section));
      } else {
        sections.forEach((section) => section.classList.add("visible"));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --navy: #1f305c;
    --red: #d33124;
    --white: #ffffff;
    --light: #f4f6fa;
    --text: #303846;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    line-height: 1.7;
  }

  header {
    background: var(--white);
    min-height: 100px;
    padding: 12px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .logo img {
    display: block;
    width: 210px;
    height: 75px;
    object-fit: contain;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  nav a {
    color: var(--navy);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  nav a:hover {
    color: var(--red);
  }

  .nav-button,
  .button {
    background: var(--red);
    color: white;
    padding: 13px 22px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 700;
    display: inline-block;
  }

  .hero {
    min-height: 590px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    padding: 75px 7%;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 76% 30%;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #1f305c 0%,
      #1f305c 28%,
      rgba(31, 48, 92, 0.96) 39%,
      rgba(31, 48, 92, 0.78) 53%,
      rgba(31, 48, 92, 0.22) 76%,
      rgba(31, 48, 92, 0.05) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 650px;
    color: white;
  }

  .eyebrow {
    color: var(--red);
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 12px;
  }

  .hero .eyebrow {
    color: #ffb0a8;
  }

  h1 {
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.12;
    margin: 15px 0 22px;
  }

  .hero-description {
    font-size: 18px;
    max-width: 560px;
    margin-bottom: 30px;
  }

  .secondary-link {
    color: white;
    margin-left: 20px;
    text-decoration: none;
    font-weight: 600;
  }

  section:not(.hero) {
    padding: 85px 9%;
  }

  h2 {
    color: var(--navy);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.2;
    margin: 10px 0 20px;
  }

  .intro,
  .about,
  .contact {
    max-width: 1100px;
    margin: auto;
    text-align: center;
  }

  .intro p:not(.eyebrow),
  .about p:not(.eyebrow),
  .contact p:not(.eyebrow) {
    max-width: 720px;
    margin: 0 auto;
  }

  .services {
    background: var(--light);
    text-align: center;
  }

  .section-description {
    margin-bottom: 40px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    max-width: 1000px;
    margin: 40px auto 0;
  }

  .service-card {
    background: white;
    text-align: left;
    padding: 32px;
    border-radius: 6px;
    border-bottom: 3px solid var(--red);
  }

  .service-card h3 {
    color: var(--navy);
    font-size: 21px;
  }

  .service-icon {
    color: var(--red);
    font-weight: 800;
    font-size: 23px;
  }

  .local {
    background: var(--navy);
    color: white;
    text-align: center;
  }

  .local h2 {
    color: white;
  }

  .local p:not(.eyebrow) {
    max-width: 700px;
    margin: auto;
  }

  .contact {
    background: var(--light);
  }

  .contact-note {
    margin-top: 25px !important;
    font-style: italic;
    color: #64748b;
  }

  footer {
    background: #152342;
    color: white;
    text-align: center;
    padding: 40px 20px;
    font-size: 13px;
  }

  footer img {
    width: 190px;
    max-height: 90px;
    object-fit: contain;
    background: white;
    border-radius: 4px;
    padding: 5px;
  }

  .fade-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease, transform 700ms ease;
  }

  .fade-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .fade-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 700px) {
    header {
      flex-direction: column;
      padding: 15px;
    }

    .logo img {
      width: 175px;
      height: 65px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
    }

    nav a {
      font-size: 12px;
    }

    .hero {
      min-height: 620px;
      padding: 55px 7%;
      align-items: flex-end;
    }

    .hero-photo {
      object-position: 72% center;
    }

    .hero::after {
      background: linear-gradient(
        0deg,
        rgba(31, 48, 92, 1) 0%,
        rgba(31, 48, 92, 0.96) 38%,
        rgba(31, 48, 92, 0.60) 70%,
        rgba(31, 48, 92, 0.15) 100%
      );
    }

    .secondary-link {
      display: block;
      margin: 22px 0 0;
    }

    section:not(.hero) {
      padding: 60px 7%;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
